# Settings for main.py. Relative paths are resolved from the code_ris_view/ folder.

# --- Paths ---
# Defect tables with final_status (output of code_silver_update_status) -> Status grain
INPUT_DIR=../silver_data_with_status
# INPUT_DIR=../input_silver_data
# INPUT_DIR=../Input_silver_data_new
# Child 10m tables master_{ravelling,roughness,rutting}_child_10m -> Total_Defects_IRC of those defects
# (status from the parent in INPUT_DIR)
CHILD_DIR=../input_silver_data
OUTPUT_DIR=../Output_KPI_data

# --- Sources ---
# Cracking source (file name without extension in INPUT_DIR). The notebook used the 10m table master_cracking.
CRACKING_TABLE=master_cracking
# Output of code_intermediate_logic (Databricks: <OUTPUT_SCHEMA>.final_intermediate)
INTERMEDIATE_PATH=../Output_KPI_data/final_intermediate.csv

# --- Project master ---
# Contract-module project master (.csv/.xlsx with a UPC/upc column); also provides length / state / NH
PROJECT_MASTER_PATH=../project_master.xlsx
# true = keep only UPCs present in the project master | false = no project-master filter
FILTER_BY_PROJECT_MASTER=true

LOG_LEVEL=INFO
