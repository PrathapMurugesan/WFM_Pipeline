# Settings for main.py. Relative paths are resolved from the code_ris_trends/ folder.

# --- Paths ---
INPUT_DIR=../Input_silver_data_new
OUTPUT_DIR=../Output_KPI_data

# --- Filters ---
# Comma-separated UPCs in '/' form (e.g. N/02015/03002/GJ,N/07024/01001/GJ). Empty = all UPCs.
KEEP_UPCS=
KEEP_PAVEMENT_TYPES=Asphalt,Cement Concrete,Hybrid
# true = Roughness_Average / Average_Rutting_Depth only from breach_flag == 1 rows
USE_BREACH_FLAG=false

# --- Reference files (not part of the silver layer) ---
# true = keep only UPCs present in the contract-module project master | false = no project-master filter
FILTER_BY_PROJECT_MASTER=true
# Contract-module project master (.csv/.xlsx with a UPC/upc column). Only read when the filter is on.
CM_PROJECT_MASTER_PATH=../project_master.xlsx
# Threshold mapping (Databricks: dlm_threshold_mapping_display): file name without extension,
# read from INPUT_DIR as .parquet / .csv / .xlsx. Required.
THRESHOLD_MAPPING_TABLE=dlm_threshold_mapping

LOG_LEVEL=INFO
