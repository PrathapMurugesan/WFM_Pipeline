# Settings for main.py. Relative paths are resolved from the code_intermediate_logic/ folder.

# --- Paths ---
INPUT_DIR=../Input_silver_data_new
OUTPUT_DIR=../Output_KPI_data

# --- Reporting intervals ---
# File name without extension, read from INPUT_DIR as .csv / .parquet / .xlsx
# (replaces the Databricks table nhai_dhms.ris_kpi_output.upc_reporting_intervals)
REPORTING_INTERVALS_TABLE=master_reporting_interval
# Interval (m) used where a reporting interval is empty or a standard (CA/IRC) has no row
DEFAULT_INTERVAL=100

# --- Sources ---
# Cracking source (file name without extension in INPUT_DIR). The notebook used the 10m table master_cracking.
CRACKING_TABLE=master_cracking

LOG_LEVEL=INFO
