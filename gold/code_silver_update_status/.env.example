# Copy this file to .env and fill in the DB_* values. Never commit .env.
# Settings for main.py. Relative paths are resolved from the code_silver_update_status/ folder.

# --- Paths ---
# Silver tables to update
INPUT_DIR=../input_silver_data
# INPUT_DIR=../Input_silver_data_new
# DB tables fetched from Postgres are stored here as <table>.csv and read from here
FETCHED_DIR=../fetched_db_tables
# Silver tables with defect_reference_id / current_status / final_status
OUTPUT_DIR=../silver_data_with_status

# --- Filters ---
# Comma-separated UPCs in '/' form (as in the notebook). Empty = all UPCs.
KEEP_UPCS=N/02015/03002/GJ,N/07024/01001/GJ

# --- DB fetch ---
# false = reuse the CSVs already in FETCHED_DIR (fetch only the missing ones) | true = always re-fetch
REFRESH_DB_TABLES=false
DB_TABLES=udm_defect_reference,dlm_defect_case
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=

LOG_LEVEL=INFO
